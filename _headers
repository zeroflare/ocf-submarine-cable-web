# Cloudflare Pages / Workers static headers
# https://developers.cloudflare.com/pages/configuration/headers/
#
# max-age  = 瀏覽器快取
# s-maxage = CDN／edge 快取（Cloudflare）
# 檔名未 fingerprint，故不做一年 immutable，部署後必要時 purge edge。

# —— HTML：瀏覽器 5 分鐘；edge 1 天 ——
/
  Cache-Control: public, max-age=300, s-maxage=86400, must-revalidate

/404.html
  Cache-Control: public, max-age=300, s-maxage=86400, must-revalidate

/articles/
  Cache-Control: public, max-age=300, s-maxage=86400, must-revalidate

/articles/*
  Cache-Control: public, max-age=300, s-maxage=86400, must-revalidate

# —— 入口網腳本／樣式：瀏覽器 1 小時；edge 7 天 ——
/assets/*
  Cache-Control: public, max-age=3600, s-maxage=604800

# —— 圖檔：瀏覽器 1 天；edge 30 天 ——
/images/*
  Cache-Control: public, max-age=86400, s-maxage=2592000

# —— 地圖 JSON：瀏覽器 30 分鐘；edge 1 天 ——
/data/*
  Cache-Control: public, max-age=1800, s-maxage=86400

# —— 檢測站靜態頁與資源：瀏覽器 1 小時；edge 7 天 ——
/web/*
  Cache-Control: public, max-age=3600, s-maxage=604800

/favicon.ico
  Cache-Control: public, max-age=86400, s-maxage=604800

/favicon.svg
  Cache-Control: public, max-age=86400, s-maxage=604800

/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=86400

/sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=86400
